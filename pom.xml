<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>edu.stanford.swrl</groupId>
    <artifactId>swrlapi-parent</artifactId>
    <version>2.1.5-SNAPSHOT</version>
    <relativePath>../swrlapi-parent/pom.xml</relativePath>
  </parent>

  <artifactId>swrltab-plugin</artifactId>
  <name>SWRLTab Plugin</name>
  <url>https://github.com/protegeproject/swrltab-plugin/wiki</url>
  <packaging>bundle</packaging>

  <properties>
    <protege.version>6.0.0-alpha-1</protege.version>
    <!-- The Protégé 6 host exports SLF4J 1.7; use its logging API in this bundle. -->
    <slf4j.version>1.7.36</slf4j.version>
  </properties>
  
  <scm>
    <connection>scm:git:git@github.com:protegeproject/swrltab-plugin.git</connection>
    <developerConnection>scm:git:git@github.com:protegeproject/swrltab-plugin.git</developerConnection>
    <url>https://github.com/protegeproject/swrltab-plugin</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/protegeproject/swrltab-plugin/issues</url>
  </issueManagement>

  <!-- Drools dependencies come transitively from swrlapi-drools-engine. -->
  <dependencies>
    <dependency>
      <groupId>edu.stanford.swrl</groupId>
      <artifactId>swrlapi</artifactId>
      <version>${project.version}</version>
      <!-- Only annotation types are needed at runtime, not the old checker/compiler. -->
      <exclusions>
        <exclusion>
          <groupId>org.checkerframework</groupId>
          <artifactId>checker</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.checkerframework</groupId>
          <artifactId>jdk8</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>edu.stanford.swrl</groupId>
      <artifactId>swrlapi-drools-engine</artifactId>
      <version>${project.version}</version>
      <!-- Only annotation types are needed at runtime, not the old checker/compiler. -->
      <exclusions>
        <exclusion>
          <groupId>org.checkerframework</groupId>
          <artifactId>checker</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.checkerframework</groupId>
          <artifactId>jdk8</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Drools' compiler references this OSGi adapter; its Spring support is unused. -->
    <dependency>
      <groupId>org.kie</groupId>
      <artifactId>kie-osgi-integration</artifactId>
      <version>${drools.version}</version>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>org.kie</groupId>
          <artifactId>kie-spring</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.springframework</groupId>
          <artifactId>spring-beans</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.springframework</groupId>
          <artifactId>spring-context</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.springframework.osgi</groupId>
          <artifactId>spring-osgi-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>edu.stanford.protege</groupId>
      <artifactId>protege-editor-core</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>edu.stanford.protege</groupId>
      <artifactId>protege-editor-owl</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>net.sourceforge.owlapi</groupId>
      <artifactId>owlapi-osgidistribution</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.eclipse.equinox</groupId>
      <artifactId>org.eclipse.equinox.registry</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.apache.geronimo.bundles</groupId>
      <artifactId>commons-discovery</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.checkerframework</groupId>
      <artifactId>checker-qual</artifactId>
    </dependency>

    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>com.google.code.findbugs</groupId>
      <artifactId>jsr305</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <instructions>
            <Bundle-SymbolicName>${project.artifactId};singleton:=true</Bundle-SymbolicName>
            <Include-Resource>plugin.xml, {maven-resources}</Include-Resource>
            <Embed-Transitive>true</Embed-Transitive>
            <!-- Embed the rule engine; OWLAPI, Protégé and logging come from the host. -->
            <Embed-Dependency>
              swrlapi, swrlapi-drools-engine, axis, checker-qual,
              drools-core, drools-compiler, drools-core-dynamic, drools-mvel, drools-core-reflective, drools-ecj,
              kie-api, kie-internal, kie-memory-compiler, kie-osgi-integration,
              kie-soup-maven-support, kie-soup-commons, kie-soup-project-datamodel-commons, kie-soup-project-datamodel-api,
              antlr-runtime, mvel2, commons-discovery, commons-codec
            </Embed-Dependency>
            <!-- OWLAPI versions its packages independently; bnd derives their ranges.
                 Optional imports cover unused Drools integrations and Axis SOAP providers. -->
            <Import-Package>
              org.protege.editor.core.*;version="[6.0.0,7.0.0)",
              org.protege.editor.owl.*;version="[6.0.0,7.0.0)",
              org.omg.*;resolution:=optional,
              org.drools.cdi.*;resolution:=optional,
              org.drools.persistence.jpa.*;resolution:=optional,
              org.drools.compiler.shade.org.eclipse.jdt.core.index.*;resolution:=optional,
              org.drools.compiler.shade.org.eclipse.jdt.core.util.*;resolution:=optional,
              org.kie.soup.xstream.*;resolution:=optional,
              org.kie.spring.*;resolution:=optional,
              org.springframework.*;resolution:=optional,
              org.appformer.maven.integration.*;resolution:=optional,
              com.ibm.*;resolution:=optional,
              com.sun.*;resolution:=optional,
              sun.*;resolution:=optional,
              javax.activation*;resolution:=optional,
              javax.enterprise.*;resolution:=optional,
              javax.inject*;resolution:=optional,
              javax.jms*;resolution:=optional,
              javax.mail*;resolution:=optional,
              javax.rmi*;resolution:=optional,
              javax.servlet*;resolution:=optional,
              javax.wsdl*;resolution:=optional,
              javax.xml.bind*;resolution:=optional,
              javax.xml.rpc*;resolution:=optional,
              javax.xml.soap*;resolution:=optional,
              org.jboss.vfs.*;resolution:=optional,
              org.apache.tools.ant.*;resolution:=optional,
              org.apache.bsf.*;resolution:=optional,
              org.apache.commons.httpclient.*;resolution:=optional,
              org.apache.commons.logging.*;resolution:=optional,
              org.apache.commons.net.*;resolution:=optional,
              org.apache.commons.modeler.*;resolution:=optional,
              org.apache.xerces.jaxp.*;resolution:=optional,
              com.thoughtworks.xstream.*;resolution:=optional,
              org.antlr.stringtemplate.*;resolution:=optional,
              org.exolab.castor.xml.*;resolution:=optional,
              *
            </Import-Package>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
